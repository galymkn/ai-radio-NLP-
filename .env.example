# Required for editor.backend = gemini (free key from https://aistudio.google.com)
GEMINI_API_KEY=

# Required only for editor.backend = claude (paid)
# ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# EDITOR_MODEL=claude-haiku-5-5
# NEWSRADIO_CONFIG=config.yaml

# Docker Compose: choose a long URL-safe password.
POSTGRES_PASSWORD=change-me-before-running
# Optional outside Docker:
# DATABASE_URL=postgresql://newsradio:password@localhost:5432/newsradio
# Required only for ingest.telegram_backend: telethon
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
